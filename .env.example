# Copy to .env and fill in what you use. Lines starting with # are comments.

# ---------------------------------------------------------------- LLM providers (at least one)
# Claude (Anthropic): API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional effort for Claude: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=high

# Swiss AI Apertus (https://huggingface.co/swiss-ai) through the Hugging Face inference router:
# fine-grained token with the "Inference Providers" permission, https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional: pin a provider on the router (publicai | featherless-ai)
# SWISSAI_PROVIDER=publicai
# Optional: use Public AI's own API (key from https://platform.publicai.co) or a local vLLM server instead
# SWISSAI_BASE_URL=https://api.publicai.co/v1
# SWISSAI_API_KEY=
# SWISSAI_MODEL=swiss-ai/apertus-v1.5-70b
# Set to false if the endpoint rejects function calling (retrieval is then injected into the prompt)
# SWISSAI_TOOLS=true

# Kimi (Moonshot): API key from https://platform.kimi.ai
MOONSHOT_API_KEY=
# Optional reasoning effort for Kimi K3: low | high | max
# KIMI_REASONING_EFFORT=low

# Optional local models through Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Skip the model question at start-up (otherwise the CLI asks which model to use)
# DEFAULT_MODEL=anthropic:claude-opus-5

# ---------------------------------------------------------------- documents
# Folder with the course material for local runs
IU_DOCS_PATH=C:/Users/X/OneDrive/IU
# Same folder for docker compose (bind-mounted read-only into the container)
IU_DOCS_HOST_PATH=C:/Users/X/OneDrive/IU
# Folder the agent may edit / run commands in when running in docker compose
WORKSPACE_HOST_PATH=./workspace
# Never index these sub folders (comma separated globs)
IU_EXCLUDE_GLOBS=Bill/**,Certificate/**,*recovery_codes*,*recovery-codes*

# ---------------------------------------------------------------- vector store and embeddings
# Leave unset for the embedded local Qdrant under DATA_DIR/qdrant, or point to a server
# QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-de
# Fast profile (~8x faster indexing on CPU, run `iu-agent ingest --reset` after switching):
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CHUNK_SIZE=450
# CHUNK_OVERLAP=60
HYBRID_SEARCH=true
DATA_DIR=data

# ---------------------------------------------------------------- myCampus (Moodle)
MOODLE_URL=https://mycampus-classic.iu.org
# Optional: a web-service token; otherwise run `iu-agent moodle login`
# MOODLE_TOKEN=
# Which forums to index: none | news | all
MOODLE_SYNC_FORUMS=news
